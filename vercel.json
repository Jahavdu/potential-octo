{
  "buildCommand": "npm run build || true",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "static",
  "public": true,
  "regions": ["sfo1"],
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "functions": {
    "server.js": {
      "runtime": "nodejs18.x",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
